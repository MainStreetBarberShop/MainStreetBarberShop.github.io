#  * Asset Fingerprinting Module
#  * Logic: Implements pHash (Perceptual Hash) for visual similarity detection.


import os
import json
import imagehash
from PIL import Image

# Directories to catalog
target_galleries = ['images/artgallery/gallery01', 'images/artgallery/gallery02']
data_dir = '_data'

print("--- [STARFIRE DISTRIBUTED AUDIT STARTING] ---")

for gallery_dir in target_galleries:
    # Use the directory name as the filename (e.g., gallery01.json)
    gallery_name = os.path.basename(gallery_dir)
    registry = {}
    
    if not os.path.exists(gallery_dir):
        print(f"Warning: {gallery_dir} not found. Skipping.")
        continue
        
    for filename in os.listdir(gallery_dir):
        if filename.lower().endswith(('.png', '.jpg', '.jpeg')):
            path = os.path.join(gallery_dir, filename)
            try:
                img = Image.open(path)
                h = str(imagehash.phash(img))
                registry[filename] = h # Key by filename for easier JS lookup
            except Exception as e:
                print(f"Error auditing {filename}: {e}")

    # Write per-gallery JSON file in _data
    output_path = os.path.join(data_dir, f"{gallery_name}.json")
    with open(output_path, 'w') as f:
        json.dump(registry, f, indent=4)
    print(f"Verified: {gallery_name} | Registry saved to {output_path}")

print("--- [AUDIT COMPLETE] ---")






