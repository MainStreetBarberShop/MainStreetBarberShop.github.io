require 'rbconfig'

Jekyll::Hooks.register :site, :post_write do |site|
  # Prevent the hook from running if we are in watch mode or if the file was just written
  # By checking the destination, we ensure we only act once the site is already built
  
  is_windows = (RbConfig::CONFIG['host_os'] =~ /mswin|mingw|cygwin/)
  python_cmd = is_windows ? "python" : "python3"
  script_path = File.expand_path("_scripts/audit.py", site.source)
  
  puts "\n[Jekyll] Integrity bridge: Triggering Audit..."
  
  # Execute the script
  success = system("#{python_cmd} \"#{script_path}\"")
  
  if success
    puts "[Jekyll] Integrity bridge: Audit complete."
  else
    puts "[Jekyll] Integrity bridge: FAILED."
  end
  
  # IMPORTANT: We exit the hook here, but Jekyll might still detect 
  # the change to _data/hashes.json. 
end